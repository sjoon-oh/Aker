# syntax=docker/dockerfile:1
#
# Debug base image (Option B):
# - Base: already-built vanilla pgvector image (PostgreSQL + upstream pgvector installed)
# - Adds: build deps + FAISS (CPU) + a baseline Aker repo checkout
#
# Runtime flow (host scripts):
#   docker run (idle) -> copy local sources into the baseline Aker repo -> build/install Aker
#   -> copy local pgvector repo -> build/install pgvector -> start postgres -> run benchmark -> docker rm
#

ARG BASE_IMAGE=aker_pgvector_vanilla:latest
FROM ${BASE_IMAGE}

ARG DEBIAN_FRONTEND=noninteractive

SHELL ["/bin/bash", "-c"]

# Build dependencies for Aker + FAISS + pgvector.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        cmake \
        ninja-build \
        python3 \
        libboost-all-dev \
        libopenblas-dev \
        libgflags-dev \
        gfortran \
        rsync \
    && rm -rf /var/lib/apt/lists/*

# Build and install FAISS (CPU only).
ARG FAISS_REPO_URL=https://github.com/facebookresearch/faiss.git
ARG FAISS_REF=
RUN set -euo pipefail; \
    git clone --recursive "${FAISS_REPO_URL}" /opt/src/faiss && \
    cd /opt/src/faiss && \
    if [ -n "${FAISS_REF}" ]; then \
        git checkout -f "${FAISS_REF}"; \
        git submodule update --init --recursive; \
    fi && \
    cmake -B build . \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DFAISS_ENABLE_GPU=OFF \
        -DFAISS_ENABLE_PYTHON=OFF \
        -DFAISS_ENABLE_CUVS=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DFAISS_ENABLE_C_API=ON \
        -DFAISS_ENABLE_MKL=OFF && \
    make -C build -j"$(nproc)" faiss && \
    make -C build -j"$(nproc)" faiss_avx2 && \
    make -C build -j"$(nproc)" faiss_avx512 && \
    make -C build install && \
    ldconfig

# Baseline Aker checkout used as a stable build skeleton.
# Host-side debug scripts will overwrite inc/src/test with locally modified files at runtime.
ARG AKER_REPO_URL=https://github.com/sjoon-oh/Aker.git
ARG AKER_REF=release
ARG AKER_SRC_DIR=/opt/src/aker

RUN set -euo pipefail; \
    git clone "${AKER_REPO_URL}" "${AKER_SRC_DIR}" && \
    cd "${AKER_SRC_DIR}" && \
    git checkout -f "${AKER_REF}" && \
    git submodule update --init --recursive
